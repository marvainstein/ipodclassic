{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ipod-classic",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ipod-classic"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		// Public host of this deployment (no protocol, no /ipod). Used to build
		// the Spotify redirect URI: https://<SITE_URL>/ipod
		"SITE_URL": "ipod-classic.marvainstein.workers.dev"
	},
	// Keep variables set in the Cloudflare dashboard across deploys.
	// Secrets (SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, APPLE_DEVELOPER_TOKEN) are
	// set as Worker secrets in the dashboard; getSecret() reads them as strings.
	"keep_vars": true
}
